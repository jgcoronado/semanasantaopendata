---
const { registros, dias, anio } = Astro.props;

const COLORES_9 = ['#6929c4','#1192e8','#005d5d','#9f1853','#fa4d56','#198038','#b28600','#012749','#8a3800'];

const regsConMetros = registros.filter((r) => r.metros != null);
const diasOrd = [...dias].sort((a, b) => a.orden - b.orden);

const altoRanking = Math.max(480, regsConMetros.length * 22);

// KPIs de resumen
const metrosOrdenados = [...regsConMetros].sort((a, b) => b.metros - a.metros);
const masLarga = metrosOrdenados[0];
const masCorta = metrosOrdenados[metrosOrdenados.length - 1];
const mediaMetros = Math.round(regsConMetros.reduce((s, r) => s + r.metros, 0) / regsConMetros.length);

const datosCliente = {
  dias: diasOrd.map((d) => ({ slug: d.slug, nombre: d.nombre, orden: d.orden })),
  registros: regsConMetros.map((r) => ({
    nombre:   r.nombre,
    diaSlug:  r.diaSlug,
    diaOrden: r.diaOrden,
    metros:   r.metros,
    noNaz:    r.noNaz,
    noTotal:  r.noTotal,
  })),
};

function fmtKm(n) {
  return (n / 1000).toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' km';
}
---

<!-- ======================== KPIs DE RECORRIDO ======================== -->
<section class="panel contenedor" id="recorridos">
  <div class="panel__cab">
    <h2>Recorridos</h2>
    <div class="panel__cab-meta">
      <span class="kpi-mini"><strong>{regsConMetros.length}</strong> hermandades con recorrido calculado</span>
      <span class="kpi-mini">media: <strong>{fmtKm(mediaMetros)}</strong></span>
      {masLarga && <span class="kpi-mini">más larga: <strong>{masLarga.nombre}</strong> ({fmtKm(masLarga.metros)})</span>}
      {masCorta && <span class="kpi-mini">más corta: <strong>{masCorta.nombre}</strong> ({fmtKm(masCorta.metros)})</span>}
      <a class="kpi-mini" href={`/${anio}/recorridos/mapa/`}>🗺 Ver todos en el mapa</a>
    </div>
  </div>
  <p class="descargas-intro">
    Distancia de la estación de penitencia de cada cofradía, medida sobre el trazado real del
    itinerario oficial del Consejo de Hermandades. Ordenadas de mayor a menor recorrido.
  </p>

  <figure class="grafica grafica--ancha">
    <figcaption>Kilómetros de recorrido por hermandad (ordenadas de mayor a menor)</figcaption>
    <div class="grafica__lienzo" style={`height:${altoRanking}px`}>
      <canvas id="rec-ranking" aria-hidden="true"></canvas>
    </div>
    <p class="grafica__nota visualmente-oculto">Barras horizontales con los kilómetros de recorrido de cada hermandad, ordenadas de mayor a menor. El color de cada barra indica el día procesional.</p>
  </figure>
</section>

<!-- ======================== DISPERSIÓN: KM VS NAZARENOS ======================== -->
<section class="panel contenedor" id="rec-dispersion">
  <div class="panel__cab"><h2>Recorrido frente a nazarenos</h2></div>
  <p class="descargas-intro">
    Cada punto es una cofradía. El eje horizontal muestra los kilómetros del recorrido y el vertical
    el número de nazarenos. Permite ver si las hermandades con mayor recorrido son también las más numerosas.
  </p>

  <figure class="grafica grafica--ancha">
    <figcaption>Recorrido (km) frente a nazarenos por hermandad</figcaption>
    <div class="grafica__lienzo" style="height:420px">
      <canvas id="rec-scatter" aria-hidden="true"></canvas>
    </div>
    <p class="grafica__nota visualmente-oculto">Gráfica de dispersión: cada punto representa una cofradía, con los kilómetros del recorrido en el eje horizontal y el número de nazarenos en el eje vertical. El color y la forma del punto indican el día procesional.</p>
  </figure>
  {anio && (
    <nav class="dia-nav" aria-label="Descargas de recorridos">
      <a class="dia-nav__a" href={`/${anio}/datos/recorridos.geojson`} download>⬇ GeoJSON recorridos {anio}</a>
    </nav>
  )}
</section>

<script type="application/json" id="datos-recorridos" set:html={JSON.stringify(datosCliente)}></script>
<script>
  import {
    Chart, BarController, BarElement, ScatterController, PointElement,
    CategoryScale, LinearScale, Tooltip, Legend,
  } from 'chart.js';
  Chart.register(BarController, BarElement, ScatterController, PointElement, CategoryScale, LinearScale, Tooltip, Legend);

  const datos = JSON.parse(document.getElementById('datos-recorridos').textContent);
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) Chart.defaults.animation = false;

  const COLORES_9 = ['#6929c4','#1192e8','#005d5d','#9f1853','#fa4d56','#198038','#b28600','#012749','#8a3800'];
  const SIMBOLOS_3 = ['circle', 'triangle', 'rect'];

  const colorDia  = (orden) => COLORES_9[(orden - 1) % 9];
  const simboloDia = (orden) => SIMBOLOS_3[(orden - 1) % 3];
  const fmtKm = (m) => (m / 1000).toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' km';

  // ── §1 Ranking horizontal: metros por hermandad, ordenados de mayor a menor ──
  const sorted = [...datos.registros].sort((a, b) => b.metros - a.metros);

  new Chart(document.getElementById('rec-ranking'), {
    type: 'bar',
    data: {
      labels: sorted.map((r) => r.nombre),
      datasets: [{
        data: sorted.map((r) => +(r.metros / 1000).toFixed(3)),
        backgroundColor: sorted.map((r) => colorDia(r.diaOrden) + 'bb'),
        borderColor:     sorted.map((r) => colorDia(r.diaOrden)),
        borderWidth: 1,
      }],
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            title: (items) => sorted[items[0].dataIndex]?.nombre ?? '',
            label: (c) => fmtKm(sorted[c.dataIndex].metros),
          },
        },
      },
      scales: {
        x: {
          title: { display: true, text: 'Kilómetros' },
          beginAtZero: true,
          ticks: { callback: (v) => v.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) },
        },
        y: { ticks: { font: { size: 11 } } },
      },
    },
  });

  // ── §2 Dispersión: km vs nazarenos ──
  const scatterDs = datos.dias
    .filter((d) => datos.registros.some((r) => r.diaSlug === d.slug))
    .map((d) => ({
      label: d.nombre,
      data: datos.registros
        .filter((r) => r.diaSlug === d.slug && r.noNaz != null)
        .map((r) => ({ x: +(r.metros / 1000).toFixed(3), y: r.noNaz, nombre: r.nombre })),
      backgroundColor: colorDia(d.orden) + 'bb',
      borderColor:     colorDia(d.orden),
      pointStyle:      simboloDia(d.orden),
      pointRadius: 7,
      pointHoverRadius: 9,
    }));

  new Chart(document.getElementById('rec-scatter'), {
    type: 'scatter',
    data: { datasets: scatterDs },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', labels: { usePointStyle: true, pointStyleWidth: 14, padding: 14 } },
        tooltip: {
          usePointStyle: true,
          callbacks: {
            title: (items) => items[0]?.raw?.nombre ?? '',
            label: (c) => `${fmtKm(c.raw.x * 1000)} · ${c.raw.y.toLocaleString('es-ES')} naz.`,
          },
        },
      },
      scales: {
        x: {
          title: { display: true, text: 'Recorrido (km)' },
          beginAtZero: true,
          ticks: { callback: (v) => v.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) },
        },
        y: { title: { display: true, text: 'Nazarenos' }, beginAtZero: true },
      },
    },
  });
</script>
