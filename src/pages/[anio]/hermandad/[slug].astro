---
import Base from '../../../layouts/Base.astro';
import GraficasHermandad from '../../../components/GraficasHermandad.astro';
import FuentesResumen from '../../../components/FuentesResumen.astro';
import RecorridoMapa from '../../../components/RecorridoMapa.astro';
import { anios, getAnio, fmt, fmtPct, fmtDur, fmtKm, variacion, hayHorarios, getHorariosAnio, aniosConHorarios, hayPasoReal, getPasoReal, getFuentesAnio, getFuentesPorIds, getComparecenciaHermandad, getFuente, hayRecorridos, getVelocidadHermandad } from '../../../lib/datos.js';

const COLORES_DIA = ['#6929c4','#1192e8','#005d5d','#9f1853','#fa4d56','#198038','#b28600','#012749','#8a3800'];

export function getStaticPaths() {
  const paths = [];
  for (const a of anios) {
    for (const r of getAnio(a.anio).registros) {
      paths.push({ params: { anio: a.slug, slug: r.slug } });
    }
  }
  return paths;
}

const { anio, slug } = Astro.params;
const anioNum = Number(anio);
const { registros } = getAnio(anioNum);

const r = registros.find((x) => x.slug === slug);
const hermsDia = registros.filter((x) => x.diaSlug === r.diaSlug);

const rankNaz = [...hermsDia].sort((a, b) => b.noNaz - a.noNaz).findIndex((x) => x.slug === slug) + 1;
const rankTotal = [...hermsDia].sort((a, b) => b.noTotal - a.noTotal).findIndex((x) => x.slug === slug) + 1;

// La misma hermandad en otros años (donde tenga datos).
const enOtrosAnios = anios
  .filter((a) => a.anio !== anioNum)
  .map((a) => ({ anio: a.anio, presente: getAnio(a.anio).registros.some((x) => x.slug === slug) }))
  .filter((x) => x.presente);

// Esta hermandad en todos los años (ascendente) para la tabla de evolución y las gráficas.
const porAnioAsc = [...anios]
  .sort((a, b) => a.anio - b.anio)
  .map((a) => {
    const d = getAnio(a.anio);
    const reg = d.registros.find((x) => x.slug === slug);
    if (!reg) return null;
    const tot = d.totalesPorDia.find((t) => t.slug === reg.diaSlug);
    const hermsDiaAnio = d.registros.filter((x) => x.diaSlug === reg.diaSlug);
    const rankNazAnio = [...hermsDiaAnio].sort((a, b) => b.noNaz - a.noNaz).findIndex((x) => x.slug === slug) + 1;
    const rankTotalAnio = [...hermsDiaAnio].sort((a, b) => b.noTotal - a.noTotal).findIndex((x) => x.slug === slug) + 1;
    return {
      anio: a.anio,
      nazarenos: reg.nazarenos, penitentes: reg.penitentes, acolitos: reg.acolitos,
      monaguillos: reg.monaguillos, acompCortejo: reg.acompCortejo,
      noNaz: reg.noNaz, noTotal: reg.noTotal, pctNaz: reg.pctNaz, pctTotal: reg.pctTotal,
      diaNoNaz: tot.noNaz, diaNoTotal: tot.noTotal,
      hdadesEnDia: hermsDiaAnio.length,
      rankNaz: rankNazAnio, rankTotal: rankTotalAnio,
      metros: reg.metros ?? null,
    };
  })
  .filter(Boolean);

const filasAnios = porAnioAsc.map((x, i) => {
  const prev = porAnioAsc[i - 1];
  return { ...x, varNaz: prev ? variacion(x.noNaz, prev.noNaz) : null, varTotal: prev ? variacion(x.noTotal, prev.noTotal) : null };
});

const tieneMetrosAlgunAnio = porAnioAsc.some((x) => x.metros != null);

// Velocidades de esta hermandad en el año actual (m/h).
const velocidad = getVelocidadHermandad(anioNum, r.id_hdad);
const fmtVel = (n) => (n == null ? '—' : n.toLocaleString('es-ES') + ' m/h');
const colorDia = COLORES_DIA[(r.diaOrden ?? 1) - 1] ?? '#6929c4';

const tramosVel = velocidad ? [
  { lbl: 'Completa', desc: 'salida → templo', v: velocidad.velocidad_mh.completa, m: velocidad.distancias_m.total, min: velocidad.duracion_min.total },
  { lbl: 'Ida', desc: 'salida → La Campana', v: velocidad.velocidad_mh.ida, m: velocidad.distancias_m.ida, min: velocidad.duracion_min.ida },
  { lbl: 'Carrera Oficial', desc: 'La Campana → Catedral', v: velocidad.velocidad_mh.carrera_oficial, m: velocidad.distancias_m.carrera_oficial, min: velocidad.duracion_min.carrera_oficial },
  { lbl: 'Vuelta', desc: 'Catedral → templo', v: velocidad.velocidad_mh.vuelta, m: velocidad.distancias_m.vuelta, min: velocidad.duracion_min.vuelta },
] : [];

// Fuentes de comparecencia de esta hermandad en cualquier año con datos.
const fuentesComparecencia = anios
  .map((a) => getComparecenciaHermandad(a.anio, r.id_hdad)?.fuente_id)
  .filter(Boolean)
  .map((id) => getFuente(id))
  .filter(Boolean);

// Todas las fuentes de la página, consolidadas en un único bloque al final.
const fuentesPagina = [...new Map(
  [
    ...anios.flatMap((a) => getFuentesAnio(a.anio, ['nazarenos', 'horarios', 'paso_real'])),
    ...fuentesComparecencia,
  ].map((f) => [f.id, f])
).values()];

const celdaVar = (v) => (v == null ? { txt: '—', cls: '' } : { txt: (v > 0 ? '+' : '') + fmtPct(v), cls: v > 0 ? 'pos' : v < 0 ? 'neg' : '' });

// Horario oficial de esta hermandad en el año mostrado (si existe).
const horario = hayHorarios(anioNum) ? getHorariosAnio(anioNum).registros.find((x) => x.id_hdad === r.id_hdad) : null;
const itinerario = horario
  ? [
      { punto: 'Salida', hora: horario.horas.salida },
      { punto: 'La Campana', hora: horario.horas.campana },
      { punto: 'Sierpes', hora: horario.horas.sierpes },
      { punto: 'Plaza S. Francisco', hora: horario.horas.plaza },
      { punto: 'Catedral', hora: horario.horas.catedral },
      { punto: 'Últ. paso (Catedral)', hora: horario.horas.ultimoPasoFuera },
      { punto: 'Entrada', hora: horario.horas.entrada, sig: horario.entradaMin >= 1440 },
    ]
  : [];

// Paso real por La Campana (si existe para el año mostrado).
const pasoReal = hayPasoReal(anioNum) ? getPasoReal(anioNum).registros.find((x) => x.idHdad === r.id_hdad) : null;

// Comparecencia (de lo anunciado a lo real) de esta hermandad en el año mostrado.
// La fuente no se muestra en la tarjeta: se consolida al final de la página.
const comparecencia = getComparecenciaHermandad(anioNum, r.id_hdad);
const etiquetaBaseComp = comparecencia?.baseNazTipo === 'nomina' ? 'la nómina de la cofradía' : 'las papeletas de sitio';

// Formatea un retraso en minutos con signo: +12 min / −5 min / En hora.
const fmtRetraso = (min) => {
  if (min === 0) return 'En hora';
  const abs = Math.abs(min);
  return `${min > 0 ? '+' : '−'}${abs} min`;
};
const clsRetraso = (min) => (min > 0 ? 'neg' : min < 0 ? 'pos' : '');

// Evolución del horario en todos los años con datos de horario para esta hermandad.
const horariosEvolucion = aniosConHorarios
  .map((a) => {
    const h = getHorariosAnio(a.anio).registros.find((x) => x.id_hdad === r.id_hdad);
    return h ? { anio: a.anio, duracionMin: h.duracionMin, carreraOficialMin: h.carreraOficialMin, cruzCarreraMin: h.cruzCarreraMin, salida: h.horas.salida, entrada: h.horas.entrada, entradaMin: h.entradaMin } : null;
  })
  .filter(Boolean)
  .sort((a, b) => a.anio - b.anio);

const metricasDesglose = [
  { etiqueta: 'Nazarenos', key: 'nazarenos' },
  { etiqueta: 'Penitentes', key: 'penitentes' },
  { etiqueta: 'Total nazarenos', key: 'noNaz', fuerte: true },
  { etiqueta: 'Acólitos', key: 'acolitos' },
  { etiqueta: 'Monaguillos', key: 'monaguillos' },
  { etiqueta: 'Acompañamiento', key: 'acompCortejo' },
  { etiqueta: 'Total cortejo', key: 'noTotal', fuerte: true },
];

const title = `${r.nombre} (${r.diaNombre}) ${anio} · nazarenos y cortejo | Semana Santa Open Data`;
const description =
  `La hermandad ${r.nombre} procesionó el ${r.diaNombre} de ${anio} con ${fmt(r.noNaz)} nazarenos ` +
  `(${fmtPct(r.pctNaz)} de su día) y ${fmt(r.noTotal)} participantes en total.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Observation',
  name: `${r.nombre} — conteo Semana Santa de Sevilla ${anio}`,
  url: new URL(`/${anio}/hermandad/${slug}/`, Astro.site).href,
  measuredProperty: 'Nazarenos y participantes del cortejo',
  observationDate: anio,
  description,
};
---

<Base title={title} description={description} jsonLd={jsonLd} anioActivo={anioNum}>
  <section class="hero">
    <div class="contenedor">
      <nav class="migas" aria-label="Migas de pan">
        <a href="/">Inicio</a> <span aria-hidden="true">›</span>
        <a href={`/${anio}/`}>{anio}</a> <span aria-hidden="true">›</span>
        <a href={`/${anio}/dia/${r.diaSlug}/`}>{r.diaNombre}</a> <span aria-hidden="true">›</span>
        <span>{r.nombre}</span>
      </nav>
      <h1>{r.nombre} <span class="h1-anio">{anio}</span></h1>
      <p>
        Procesionó el <a href={`/${anio}/dia/${r.diaSlug}/`}>{r.diaNombre}</a> de la Semana Santa de
        Sevilla {anio}. Es la <strong>{rankNaz}.ª</strong> de su día por número de nazarenos y la
        <strong>{rankTotal}.ª</strong> por cortejo total (de {hermsDia.length}).
        {enOtrosAnios.length > 0 && (
          <span> Ver esta hermandad en {enOtrosAnios.map((o, i) => (<>{i > 0 ? ', ' : ' '}<a href={`/${o.anio}/hermandad/${slug}/`}>{o.anio}</a></>))}, o en la <a href="/comparativa/">comparativa</a>.</span>
        )}
      </p>

      <div class="kpis">
        <div class="kpi">
          <div class="kpi__num">{fmt(r.noNaz)}</div>
          <div class="kpi__lbl">Nazarenos</div>
        </div>
        <div class="kpi">
          <div class="kpi__num">{fmtPct(r.pctNaz)}</div>
          <div class="kpi__lbl">de los nazarenos del día</div>
        </div>
        <div class="kpi">
          <div class="kpi__num">{fmt(r.noTotal)}</div>
          <div class="kpi__lbl">Participantes en el cortejo</div>
        </div>
        <div class="kpi">
          <div class="kpi__num">{fmtPct(r.pctTotal)}</div>
          <div class="kpi__lbl">del cortejo del día</div>
        </div>
        {r.metros != null && (
          <div class="kpi">
            <div class="kpi__num">{fmtKm(r.metros)}</div>
            <div class="kpi__lbl">Recorrido {anio}</div>
          </div>
        )}
        {velocidad && (
          <div class="kpi">
            <div class="kpi__num">{fmtVel(velocidad.velocidad_mh.completa)}</div>
            <div class="kpi__lbl">Velocidad media {anio}</div>
          </div>
        )}
      </div>
    </div>
    {r.metros != null && !velocidad && (
      <nav class="dia-nav contenedor" style="padding-top:0.75rem" aria-label="Descarga de recorrido">
        <a class="dia-nav__a" href={`/${anio}/datos/recorrido/${slug}.geojson`} download>⬇ GeoJSON recorrido {anio}</a>
      </nav>
    )}
  </section>

  {velocidad && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Velocidad {anio}</h2></div>
      <p class="descargas-intro">
        Velocidad media de la <strong>cruz de guía</strong> sobre el trazado real, en metros por hora.
        La de Carrera Oficial viene marcada por el paso regulado; la de vuelta descuenta el tiempo de paso del cortejo.
      </p>
      <table class="tabla">
        <thead>
          <tr>
            <th scope="col">Tramo</th>
            <th scope="col">Recorrido</th>
            <th scope="col">Tiempo</th>
            <th scope="col">Velocidad</th>
          </tr>
        </thead>
        <tbody>
          {tramosVel.map((t) => (
            <tr>
              <th scope="row">{t.lbl} <span class="it-punto">{t.desc}</span></th>
              <td>{fmtKm(t.m)}</td>
              <td>{fmtDur(t.min)}</td>
              <td>{fmtVel(t.v)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <nav class="dia-nav" aria-label="Más">
        <a class="dia-nav__a" href={`/${anio}/datos/recorrido/${slug}.geojson`} download>⬇ GeoJSON recorrido {anio}</a>
        <a class="dia-nav__a dia-nav__der" href={`/${anio}/#velocidades`}>Ver todas las velocidades →</a>
      </nav>
    </section>
  )}

  {anioNum === 2025 && r.metros != null && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Recorrido {anio}</h2></div>
      <p class="descargas-intro">
        Trazado real de la estación de penitencia de <strong>{r.nombre}</strong> en {anio}.
        {r.metros != null && <> Distancia total: <strong>{fmtKm(r.metros)}</strong>.</>}
        {horario && <> Haz clic en los marcadores para ver los hitos de la Carrera Oficial con sus horas oficiales.</>}
      </p>
      <RecorridoMapa
        idHdad={r.id_hdad}
        slug={slug}
        colorDia={colorDia}
        nombre={r.nombre}
        horario={horario}
        pasoReal={pasoReal}
        metros={r.metros}
      />
    </section>
  )}

  {horario && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Horario oficial {anio}</h2></div>
      <p class="descargas-intro">
        Duración <strong>{fmtDur(horario.duracionMin)}</strong> · en Carrera Oficial
        <strong>{fmtDur(horario.carreraOficialMin)}</strong>.
      </p>
      <ul class="itinerario">
        {itinerario.map((it) => (
          <li>
            <span class="it-punto">{it.punto}</span>
            <span class="it-hora">{it.hora}{it.sig && <span class="dia-sig"> +1</span>}</span>
          </li>
        ))}
      </ul>
      <nav class="dia-nav" aria-label="Más">
        <a class="dia-nav__a dia-nav__der" href={`/${anio}/#horarios`}>Ver todos los horarios →</a>
      </nav>
    </section>
  )}

  {pasoReal && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Paso real por La Campana {anio}</h2></div>
      <p class="descargas-intro">
        Tiempos reales registrados al paso por La Campana durante el desfile de {anio}.
        El retraso acumulado mide los minutos de adelanto (−) o retraso (+) respecto al horario oficial.
      </p>
      <ul class="itinerario">
        <li>
          <span class="it-punto">Cruz de Guía en La Campana</span>
          <span class="it-hora">{pasoReal.cruzGuiaCampana}</span>
        </li>
        <li>
          <span class="it-punto">Último paso en La Campana</span>
          <span class="it-hora">{pasoReal.ultimoPasoCampana}</span>
        </li>
      </ul>
      <div class="kpis" style="margin-top:1rem">
        <div class="kpi">
          <div class="kpi__num">{pasoReal.tiempoPasoRealCampana} min</div>
          <div class="kpi__lbl">Duración real del paso (Campana)</div>
        </div>
        <div class="kpi">
          <div class="kpi__num">{pasoReal.tiempoPasoOficial} min</div>
          <div class="kpi__lbl">Duración oficial del paso</div>
        </div>
        <div class="kpi">
          <div class={`kpi__num var ${clsRetraso(pasoReal.acumuladoCampana)}`}>{fmtRetraso(pasoReal.acumuladoCampana)}</div>
          <div class="kpi__lbl">Retraso acumulado en Campana</div>
        </div>
        <div class="kpi">
          <div class={`kpi__num var ${clsRetraso(pasoReal.acumuladoCatedral)}`}>{fmtRetraso(pasoReal.acumuladoCatedral)}</div>
          <div class="kpi__lbl">Retraso acumulado en Catedral</div>
        </div>
      </div>
      {pasoReal.tiempoRecortado !== 0 && (
        <p class="descargas-intro" style="margin-top:1rem">
          Entre La Campana y la Catedral {pasoReal.tiempoRecortado > 0
            ? <><strong class="var pos">recuperó {pasoReal.tiempoRecortado} min</strong> respecto al acumulado en Campana.</>
            : <><strong class="var neg">perdió {Math.abs(pasoReal.tiempoRecortado)} min</strong> adicionales respecto al acumulado en Campana.</>
          }
        </p>
      )}
      <nav class="dia-nav" aria-label="Más">
        <a class="dia-nav__a dia-nav__der" href={`/${anio}/#carrera-oficial`}>Ver todos los datos de la Carrera Oficial →</a>
      </nav>
    </section>
  )}

  {comparecencia && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>De lo anunciado a lo real {anio}</h2></div>
      <p class="descargas-intro">
        Cuántos cofrades salieron realmente frente a los anunciados, según {etiquetaBaseComp}.
      </p>
      <div class="kpis">
        <div class="kpi">
          <div class="kpi__num">{comparecencia.baseNaz != null ? fmt(comparecencia.baseNaz) : '—'}</div>
          <div class="kpi__lbl">Nazarenos anunciados</div>
        </div>
        <div class="kpi">
          <div class="kpi__num">{comparecencia.nazarenos.salida != null ? fmt(comparecencia.nazarenos.salida) : '—'}</div>
          <div class="kpi__lbl">Salieron de verdad</div>
        </div>
        {comparecencia.comparecenciaNaz != null && (
          <div class="kpi">
            <div class="kpi__num">{fmtPct(comparecencia.comparecenciaNaz)}</div>
            <div class="kpi__lbl">Comparecencia</div>
          </div>
        )}
        {comparecencia.ausenciasNaz != null && (
          <div class="kpi">
            <div class="kpi__num var neg">{fmt(comparecencia.ausenciasNaz)}</div>
            <div class="kpi__lbl">No comparecieron</div>
          </div>
        )}
      </div>
      {(comparecencia.mermaRecorridoNaz != null || comparecencia.pctCompletaron != null || (comparecencia.cortejo && comparecencia.cortejo.salida != null)) && (
        <p class="descargas-intro" style="margin-top:1rem">
          {comparecencia.cortejo && comparecencia.cortejo.salida != null && (
            <>Cortejo completo: <strong>{fmt(comparecencia.cortejo.salida)}</strong> de {fmt(comparecencia.baseCortejo)} de nómina ({fmtPct(comparecencia.comparecenciaCortejo)}). </>
          )}
          {comparecencia.mermaRecorridoNaz != null && (
            <>Entre la salida y la entrada al templo <strong class="var neg">se retiró un {fmtPct(Math.abs(comparecencia.mermaRecorridoNaz))}</strong> de los nazarenos. </>
          )}
          {comparecencia.pctCompletaron != null && (
            <>Tras la lluvia, <strong>{fmtPct(comparecencia.pctCompletaron)}</strong> completó la estación. </>
          )}
        </p>
      )}
      {comparecencia.nota && <p class="descargas-intro" style="margin-top:0.5rem">{comparecencia.nota}</p>}
      <nav class="dia-nav" aria-label="Más">
        <a class="dia-nav__a dia-nav__der" href={`/${anio}/#comparecencia`}>Ver la comparecencia de todas las hermandades →</a>
      </nav>
    </section>
  )}

  {horariosEvolucion.length >= 2 && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Evolución del horario</h2></div>
      <p class="descargas-intro">Comparativa de duración y ritmo en los años con horario oficial disponible.</p>
      <div class="tabla-wrap">
        <table class="datos">
          <caption>Duración y tiempo en Carrera Oficial de {r.nombre} por año.</caption>
          <thead>
            <tr>
              <th scope="col">Año</th>
              <th scope="col">Salida</th>
              <th scope="col">Entrada</th>
              <th scope="col">Duración</th>
              <th scope="col">En Carrera Oficial</th>
            </tr>
          </thead>
          <tbody>
            {horariosEvolucion.map((h) => (
              <tr class={h.anio === anioNum ? 'fila-resaltada' : ''}>
                <td class="txt fuerte">{h.anio}</td>
                <td>{h.salida}</td>
                <td>{h.entrada}{h.entradaMin >= 1440 && <span class="dia-sig"> +1<span class="visualmente-oculto"> (día siguiente)</span></span>}</td>
                <td>{fmtDur(h.duracionMin)}</td>
                <td>{fmtDur(h.carreraOficialMin)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="panel contenedor">
    <div class="panel__cab"><h2>Desglose por año</h2></div>
    <div class="tabla-wrap">
      <table class="datos">
        <caption>Composición completa de {r.nombre} por año (la columna de {anio}, el año que estás viendo, va resaltada).</caption>
        <thead>
          <tr>
            <th class="txt" scope="col">Concepto</th>
            {porAnioAsc.map((x) => <th scope="col" class={x.anio === anioNum ? 'col-actual' : ''}>{x.anio}</th>)}
          </tr>
        </thead>
        <tbody>
          {metricasDesglose.map((m) => (
            <tr>
              <td class="txt">{m.etiqueta}</td>
              {porAnioAsc.map((x) => (
                <td class={`${m.fuerte ? 'fuerte' : ''} ${x.anio === anioNum ? 'col-actual' : ''}`.trim()}>{fmt(x[m.key])}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel contenedor">
    <div class="panel__cab"><h2>Datos por año</h2></div>
    <div class="tabla-wrap">
      <table class="datos">
        <caption>Cifras de {r.nombre} por año. La variación compara cada año con el anterior disponible.</caption>
        <thead>
          <tr>
            <th class="txt" scope="col">Año</th>
            <th scope="col">Nazarenos</th>
            <th scope="col">Var.</th>
            <th scope="col">Cortejo</th>
            <th scope="col">Var.</th>
            <th scope="col">% día (naz.)</th>
            <th scope="col">% día (cortejo)</th>
            {tieneMetrosAlgunAnio && <th scope="col">Recorrido</th>}
          </tr>
        </thead>
        <tbody>
          {filasAnios.map((f) => {
            const vn = celdaVar(f.varNaz);
            const vt = celdaVar(f.varTotal);
            return (
              <tr class={f.anio === anioNum ? 'fila-resaltada' : ''}>
                <td class="txt fuerte"><a href={`/${f.anio}/hermandad/${slug}/`}>{f.anio}</a></td>
                <td>{fmt(f.noNaz)}</td>
                <td class={`var ${vn.cls}`}>{vn.txt}</td>
                <td>{fmt(f.noTotal)}</td>
                <td class={`var ${vt.cls}`}>{vt.txt}</td>
                <td>{fmtPct(f.pctNaz)}</td>
                <td>{fmtPct(f.pctTotal)}</td>
                {tieneMetrosAlgunAnio && <td>{f.metros != null ? fmtKm(f.metros) : '—'}</td>}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {porAnioAsc.length >= 2 && (
    <section class="panel contenedor">
      <div class="panel__cab"><h2>Posición en el día</h2></div>
      <p class="descargas-intro">Posición de {r.nombre} entre las hermandades de su día, ordenadas por número de nazarenos o total del cortejo.</p>
      <div class="tabla-wrap">
        <table class="datos">
          <caption>Ranking de {r.nombre} dentro de las hermandades del {r.diaNombre} por año.</caption>
          <thead>
            <tr>
              <th class="txt" scope="col">Año</th>
              <th scope="col">Hermandades ese día</th>
              <th scope="col">Pos. por nazarenos</th>
              <th scope="col">Pos. por cortejo</th>
            </tr>
          </thead>
          <tbody>
            {porAnioAsc.map((f) => (
              <tr class={f.anio === anioNum ? 'fila-resaltada' : ''}>
                <td class="txt fuerte"><a href={`/${f.anio}/hermandad/${slug}/`}>{f.anio}</a></td>
                <td>{f.hdadesEnDia}</td>
                <td class="fuerte">{f.rankNaz}.ª de {f.hdadesEnDia}</td>
                <td class="fuerte">{f.rankTotal}.ª de {f.hdadesEnDia}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="panel contenedor">
    <div class="panel__cab"><h2>Gráficas</h2></div>

    <GraficasHermandad nombre={r.nombre} datos={porAnioAsc} />

    <nav class="dia-nav" aria-label="Más">
      <a class="dia-nav__a" href={`/${anio}/dia/${r.diaSlug}/`}>← Todas las hermandades del {r.diaNombre}</a>
      <a class="dia-nav__a dia-nav__der" href="/comparativa/">Comparar años →</a>
    </nav>
    <FuentesResumen fuentes={fuentesPagina} />
  </section>
</Base>
