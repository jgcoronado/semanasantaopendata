---
/**
 * Editor de recorridos: del itinerario en texto (lista de calles) a una línea sobre el mapa.
 * Funciona en cualquier municipio andaluz con el Callejero Digital de Andalucía Unificado.
 * Toda la lógica es del lado del cliente (src/lib/recorridos/); esta página solo monta la UI.
 */
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import hermandades from '../../data/hermandades.json';
import dias from '../../data/dias.json';
import carrerasOficiales from '../../data/carreras-oficiales.json';
import aniosDatos from '../../data/anios.json';
import '../../styles/recorridos.css';

const COLORES_DIA = ['#6929c4','#1192e8','#005d5d','#9f1853','#fa4d56','#198038','#b28600','#012749','#8a3800'];
const ordenDia = new Map(dias.map((d) => [d.slug, d.orden]));

// Recorridos publicados por año en public/geojson/AAAA/NN-slug.geojson: { año: { id_hdad: url } }.
const dirGeojson = join(process.cwd(), 'public', 'geojson');
const publicados = Object.fromEntries(
  readdirSync(dirGeojson).filter((a) => /^\d{4}$/.test(a)).map((anio) => [anio, Object.fromEntries(
    readdirSync(join(dirGeojson, anio)).filter((f) => /^\d+-.*\.geojson$/.test(f)).map((f) => [Number(f.split('-')[0]), `/geojson/${anio}/${f}`]),
  )]),
);
const archivos2025 = readdirSync(join(dirGeojson, '2025'));

// Carreras Oficiales predeterminadas por código INE (sin la clave de notas).
const carreras = Object.fromEntries(Object.entries(carrerasOficiales).filter(([k]) => !k.startsWith('_')));

const datos = {
  carreras,
  publicados,
  // Años del proyecto y los que ya tienen recorridos publicados (el editor añade el actual).
  anios: [...new Set([...aniosDatos.map((a) => a.anio), ...Object.keys(publicados).map(Number)])],
  hermandades: [...hermandades]
    .sort((a, b) => (ordenDia.get(a.dia) - ordenDia.get(b.dia)) || a.id_hdad - b.id_hdad)
    .map((h) => {
      const prefijo = String(h.id_hdad).padStart(2, '0') + '-';
      const f = archivos2025.find((x) => x.startsWith(prefijo));
      // Primer punto del recorrido 2025 = puerta del templo (salida), para buscarla por hermandad.
      let salida2025 = null;
      if (f) {
        const geo = JSON.parse(readFileSync(join(process.cwd(), 'public', 'geojson', '2025', f), 'utf8'));
        const c = geo.features.find((x) => x.geometry?.type === 'LineString')?.geometry.coordinates[0];
        if (c) salida2025 = [Math.round(c[0] * 1e6) / 1e6, Math.round(c[1] * 1e6) / 1e6];
      }
      return {
        id_hdad: h.id_hdad,
        nombre: h.nombre,
        slug: h.slug,
        dia: h.dia,
        color: COLORES_DIA[(ordenDia.get(h.dia) ?? 1) - 1],
        salida2025,
      };
    }),
};

const title = 'Editor de recorridos de procesiones | Semana Santa Open Data';
const description =
  'Traza sobre el mapa el recorrido de una procesión a partir de su itinerario (lista de calles), con el callejero oficial de Andalucía.';
---

<Base title={title} description={description} indexar={false}>
  <div class="ed">
    <aside class="ed__panel" aria-label="Itinerario">
      <h1 class="ed__titulo">Editor de recorridos</h1>
      <p class="ed__intro">
        Escribe el itinerario como lista de calles y el editor dibuja el recorrido con el
        callejero oficial de Andalucía. Corrige lo que haga falta en la lista o arrastrando
        puntos sobre la línea.
      </p>

      <section class="ed__bloque">
        <h2><span class="ed__num">1</span> Municipio</h2>
        <input id="ed-municipio" class="ed__input" list="ed-municipios" autocomplete="off" aria-label="Municipio" placeholder="Escribe el municipio…" />
        <datalist id="ed-municipios"></datalist>
        <small id="ed-mun-estado" class="ed__nota"></small>
      </section>

      <section class="ed__bloque">
        <h2><span class="ed__num">2</span> Salida</h2>
        <div class="ed-buscador">
          <input id="ed-lugar" class="ed__input" type="search" autocomplete="off" role="combobox"
            aria-autocomplete="list" aria-expanded="false" aria-controls="ed-lugar-lista"
            placeholder="Templo o hermandad: «Parroquia de la Magdalena»…" aria-label="Buscar el templo de salida" />
          <ul id="ed-lugar-lista" class="ed-buscador__lista" role="listbox" hidden></ul>
        </div>
        <small id="ed-lugar-estado" class="ed__nota"></small>
        <p class="ed__o">o por dirección</p>
        <div class="ed__direccion">
          <input id="ed-salida-calle" class="ed__input" list="ed-calles" autocomplete="off" placeholder="Calle o plaza del templo…" aria-label="Calle de la salida" />
          <input id="ed-salida-num" class="ed__input" list="ed-portales" autocomplete="off" inputmode="numeric" placeholder="Nº" aria-label="Número de la salida" disabled />
        </div>
        <datalist id="ed-portales"></datalist>
        <div class="ed__fila">
          <button id="ed-btn-salida" type="button" class="btn btn--sec">Fijar en el mapa</button>
          <span id="ed-salida-txt" class="ed__nota">Sin fijar</span>
        </div>
        <small class="ed__nota">El marcador cae en el centro del templo o en el portal: arrástralo a la puerta por la que sale la cofradía.</small>
        <label class="campo">La puerta da a
          <input id="ed-puerta-calle" class="ed__input" list="ed-calles" autocomplete="off" placeholder="Automática: la calle más cercana" />
        </label>
        <div class="ed-co__fila">
          <span class="ed-co__etq">Entrada</span>
          <span id="ed-entrada-txt" class="ed__nota">Por la misma puerta</span>
          <button id="ed-btn-entrada" type="button" class="ed-mini" title="Fijar en el mapa otra puerta de entrada" aria-label="Fijar en el mapa otra puerta de entrada">📍</button>
          <button id="ed-entrada-quitar" type="button" class="ed-mini" title="Entrar por la misma puerta" aria-label="Entrar por la misma puerta" hidden>✕</button>
        </div>
        <label class="campo">La puerta de entrada da a
          <input id="ed-entrada-calle" class="ed__input" list="ed-calles" autocomplete="off" placeholder="La misma que la de salida" />
        </label>
        <small class="ed__nota">Si el templo tiene fachada a varias calles, indica a cuál da la puerta: el cortejo arranca (y termina) en esa calle aunque otra quede más cerca del marcador.</small>
      </section>

      <section class="ed__bloque">
        <h2><span class="ed__num">3</span> Itinerario</h2>
        <textarea id="ed-texto" class="ed__input ed__texto" rows="10" spellcheck="false"
          placeholder={'Una calle por línea o separadas por comas, en orden:\nPuerta del Perdón\nAlemanes\nCardenal Carlos Amigo\n…\nCarrera Oficial\n…'}></textarea>
        <small class="ed__nota">Escribe «Carrera Oficial» donde corresponda: se sustituye por la del municipio (abajo). Si la primera línea es el templo, se toma como la salida.</small>
        <button id="ed-btn-trazar" type="button" class="btn ed__trazar">Trazar recorrido</button>
      </section>

      <section class="ed__bloque">
        <h2><span class="ed__num ed__num--co">CO</span> Carrera Oficial <small id="ed-co-resumen" class="ed__nota"></small></h2>
        <p id="ed-co-detalle" class="ed__nota ed__parrafo"></p>
        <div class="ed__fila">
          <a id="ed-co-enlace" class="btn btn--sec" href="/recorridos/carrera-oficial/" target="_blank" rel="noopener">Revisar o cambiar</a>
        </div>
        <small class="ed__nota">Es la misma para todas las cofradías del municipio: se define en su propia ventana y aquí se usa tal cual.</small>
      </section>

      <p id="ed-mensaje" class="ed__mensaje" role="status" aria-live="polite"></p>

      <section id="ed-resultado" class="ed__bloque" hidden>
        <h2>Recorrido</h2>
        <p id="ed-resumen" class="ed__resumen"></p>
        <ul id="ed-avisos" class="ed__avisos"></ul>
        <div class="ed__leyenda" aria-hidden="true">
          <span><i class="ed-ley ed-ley--calle"></i>Calles</span>
          <span><i class="ed-ley ed-ley--co"></i>Carrera Oficial</span>
          <span><i class="ed-ley ed-ley--manual"></i>Corregido a mano</span>
          <span><i class="ed-ley ed-ley--recta"></i>Sin conexión</span>
        </div>
        <ol id="ed-items" class="ed-items"></ol>
        <button id="ed-btn-borrar-puntos" type="button" class="btn btn--sec" hidden>Quitar todos los puntos de paso</button>
      </section>

      <section class="ed__bloque">
        <h2>Guardar</h2>
        <div id="ed-bloque-hdad" class="ed__sub">
          <label class="campo">Hermandad (Sevilla)
            <select id="ed-hermandad"></select>
          </label>
        </div>
        <label class="campo">Cofradía o nombre del recorrido
          <input id="ed-nombre" class="ed__input" type="text" autocomplete="off" placeholder="Fuera de Sevilla, o sin elegir hermandad" />
        </label>
        <label class="campo">Año
          <select id="ed-anio"></select>
        </label>
        <div id="ed-existente" class="ed-existente" role="status" hidden>
          <p id="ed-existente-txt" class="ed__parrafo"></p>
          <div class="ed__fila">
            <button id="ed-btn-abrir-existente" type="button" class="btn btn--sec">Abrir el existente</button>
            <button id="ed-btn-ref" type="button" class="btn btn--sec" hidden>Ocultar su trazado</button>
          </div>
        </div>
        <div class="ed__fila">
          <button id="ed-btn-guardar" type="button" class="btn">Guardar</button>
          <button id="ed-btn-exportar" type="button" class="btn btn--sec">Descargar GeoJSON</button>
          <label class="btn btn--sec ed__importar">Abrir GeoJSON<input id="ed-importar" type="file" accept=".geojson,.json,application/geo+json,application/json" /></label>
        </div>
        <small class="ed__nota">«Guardar» lo deja en este navegador para esa cofradía y año. Para publicarlo en la web, «Descargar GeoJSON» y súbelo a <code>public/geojson/AAAA/</code> (y <code>scripts/geojson-AAAA/</code>). El GeoJSON guarda también el itinerario y las correcciones para volver a abrirlo aquí.</small>
      </section>
    </aside>

    <div id="ed-mapa" class="ed__mapa" role="application" aria-label="Mapa del recorrido"></div>
  </div>
  <datalist id="ed-calles"></datalist>

  <script type="application/json" id="ed-datos" set:html={JSON.stringify(datos)}></script>
</Base>

<script>
  import 'leaflet/dist/leaflet.css';
  import { iniciarEditor } from '../../lib/recorridos/editor.js';

  const datos = JSON.parse(document.getElementById('ed-datos')!.textContent!);
  iniciarEditor(datos);
</script>


